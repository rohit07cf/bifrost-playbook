# Copy this file to `.env` and fill in real values.
# `.env` is gitignored so your secrets stay out of source control.

# --- Provider keys (Bifrost reads these via `env.OPENAI_API_KEY` etc.) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Bifrost gateway location ---
# Where this app expects Bifrost to be listening.
BIFROST_HOST=127.0.0.1
BIFROST_PORT=8080

# Set to `1` (default) to have the Streamlit app start Bifrost as a
# subprocess via `npx -y @maximhq/bifrost`. Set to `0` if you want to
# run Bifrost yourself (e.g. in another terminal or as a system service).
BIFROST_AUTOSTART=1
